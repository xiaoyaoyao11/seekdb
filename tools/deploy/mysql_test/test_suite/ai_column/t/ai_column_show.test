# SHOW AI COLUMNS coverage.  No external model request is made.

connection default;
--disable_warnings
drop database if exists ai_column_p0_show;
--enable_warnings
create database ai_column_p0_show;

--error 0,11112
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('p0_show_complete_ep');
--error 0,11118
call DBMS_AI_SERVICE.DROP_AI_MODEL('p0_show_complete');
call DBMS_AI_SERVICE.CREATE_AI_MODEL('p0_show_complete',
  '{"type":"completion","model_name":"mock-complete"}');
call DBMS_AI_SERVICE.CREATE_AI_MODEL_ENDPOINT('p0_show_complete_ep',
  '{"ai_model_name":"p0_show_complete","url":"http://127.0.0.1:19125/v1/chat/completions","access_key":"p0-key","provider":"openai","request_model_name":"mock-complete"}');

drop table if exists ai_column_p0_show.docs;
create table ai_column_p0_show.docs (
  id bigint primary key,
  content varchar(200),
  tags json AI COLUMN (
    AI_COMPLETE('p0_show_complete', concat('Classify: ', content))
  ) WITH (sync_mode='async', max_retries=2),
  label varchar(400) AI COLUMN (
    AI_COMPLETE('p0_show_complete', content)
  ) WITH (sync_mode='async', max_retries=1)
);

# The statement reports the AI columns of the table with their definition.
show ai columns from ai_column_p0_show.docs;

# The qualified form works the same way.
show ai columns from ai_column_p0_show.docs like 'tag';

# A table without AI columns reports no rows.
create table ai_column_p0_show.plain_docs(id bigint primary key, content varchar(20));
show ai columns from ai_column_p0_show.plain_docs;
drop table ai_column_p0_show.plain_docs;

# An unknown table is reported as such.
--error 1146
show ai columns from ai_column_p0_show.no_such_table;

drop table ai_column_p0_show.docs;
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('p0_show_complete_ep');
call DBMS_AI_SERVICE.DROP_AI_MODEL('p0_show_complete');
drop database ai_column_p0_show;
